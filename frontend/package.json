    "smoke:sidecar": "node scripts/smoke-sidecar.cjs",
    "verify:sidecar-bundle": "node scripts/verify-sidecar-bundle.cjs",
    "test": "tsc -p tsconfig.test.json && node scripts/prepare-test-package.cjs && node -e \"import('./.test-dist/test/system-tests.js').then(() => process.exit(0)).catch(error => { console.error(error); process.exit(1); })\"",
    "preview": "vite preview"
  },
